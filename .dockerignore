# Keep the build context minimal and never bake secrets into an image layer.
.env
.env.*
!.env.example

.git/
.github/
.venv/
venv/
dist/
outputs/
build/
*.egg-info/

__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Not needed to build or run the converter. The Dockerfile copies an explicit
# allowlist (pyproject.toml, uv.lock, src), so this list only keeps the build
# context small.
tests/
Makefile
scripts/
compose.yaml

.DS_Store
Thumbs.db
.idea/
.vscode/
