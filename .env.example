# LLM Provider Configuration
LLM_PROVIDER=google
LLM_MODEL=gemini-2.5-flash

# Google API Key (for gemini-2.5-flash, gemini-2.5-pro, etc.)
GOOGLE_API_KEY=your_google_api_key_here

# OpenAI API Key (for gpt-4o-mini, gpt-4o, etc.)
# OPENAI_API_KEY=your_openai_api_key_here

# Anthropic API Key (for claude-3-5-haiku, claude-sonnet-4, etc.)
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# AWS credentials (for Bedrock)
# Set BOTH region variables: botocore reads only AWS_DEFAULT_REGION, while
# langchain-aws (used by the generated code) reads AWS_REGION. There is no
# implicit default region any more -- unset means NoRegionError, not us-east-1.
# AWS_REGION=ap-northeast-1
# AWS_DEFAULT_REGION=ap-northeast-1
#
# AWS_PROFILE selects a profile from ~/.aws. Leave it UNSET when passing static
# credentials (AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY / AWS_SESSION_TOKEN)
# without ~/.aws -- e.g. a Docker run with no ~/.aws mount -- because naming a
# missing profile fails with ProfileNotFound even though the keys are valid.
# AWS_PROFILE=default

# LangSmith tracing (optional)
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=lsv2_...
# LANGSMITH_PROJECT=dify2langgraph

# Logging
# LOG_LEVEL=INFO
# LOG_FORMAT=console
